    <!-- Local web page on the phone (KeyServer) -->
    <string name="setup_web_title">Halo · Assistant key</string>
    <string name="setup_web_heading">Send your Gemini API key to your TV</string>
    <string name="setup_web_intro">Paste your key below. It goes straight to your TV over your home network and is stored only on the TV.</string>
    <string name="setup_web_label">Gemini API key</string>
    <string name="setup_web_send">Send to TV</string>
    <string name="setup_web_get_key">No key yet? Create one for free:</string>
    <string name="setup_web_footer">This page only works while the Assistant step is open on the TV.</string>
    <string name="setup_web_ok_heading">Key received ✓</string>
    <string name="setup_web_ok_text">Halo checked your key with Google and saved it on the TV. You can close this page.</string>
    <string name="setup_web_bad_heading">That didn’t work</string>
    <string name="setup_web_bad_text">Google didn’t accept this key. Make sure you copied all of it, then try again.</string>
    <string name="setup_web_format_text">This doesn’t look like an API key. Copy the whole key and try again.</string>
    <string name="setup_web_busy_text">The TV is still checking the previous key. Wait a moment and try again.</string>
    <string name="setup_web_too_large">That was too much text. Paste only the key.</string>
    <string name="setup_web_offline_heading">Couldn’t check the key</string>
    <string name="setup_web_offline_text">The TV couldn’t reach Google. Check the TV’s internet connection, then try again.</string>
    <string name="setup_web_expired_heading">This link has expired</string>
    <string name="setup_web_expired_text">Open the Assistant step on the TV and scan the new code.</string>
    <string name="setup_web_too_many">Too many attempts. Scan the new code on the TV.</string>
    <string name="setup_web_used_heading">Key already received</string>
    <string name="setup_web_used_text">The TV already got a key from this code. To change it, open Settings → Assistant key on the TV.</string>
    <string name="setup_web_try_again">Try again</string>
    <string name="setup_assistant_phone_off">Not active. Show a code to send a new key from your phone.</string>
