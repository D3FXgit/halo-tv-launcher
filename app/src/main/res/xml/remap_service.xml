<?xml version="1.0" encoding="utf-8"?>
<!-- Window events only from the stock launchers (Home override) and the TV's Settings app (pressing
     "Force stop" when the user asks in Halo's Running apps); key events are not filtered by package.
     Keep the launcher packages in sync with DefaultLauncher.STOCK_LAUNCHERS. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0"
    android:packageNames="com.google.android.apps.tv.launcherx,com.google.android.tvlauncher,com.google.android.leanbacklauncher,com.android.tv.launcher,com.amazon.tv.launcher,com.android.tv.settings,com.android.settings,com.google.android.tv.settings"
    android:description="@string/setup_a11y_service_description" />
